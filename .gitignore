# --- Editor / OS ---
.vscode/
.idea/
.DS_Store

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
dist/
build/

# --- Local env & package manager (large / machine-specific) ---
.venv/
venv/
.env
.env.*
.python-version
.python_history
.python_history*.tmp

# uv: keep lockfile in repo for reproducible installs; cache stays local
uv/cache/
uv/pythons/
uv/tools/

# --- experiments/: version control for code & configs only ---
# Ignore the tree, then allow source-like paths (see README). Data stay ignored by default.
# Parked cytokine CV trees (large run snapshots); active CxP work lives under experiments/cxp/.
experiments/cytokine_validation*/
# Training run directories (config snapshots + lightning); keep templates under experiments/cxp/configs/
experiments/**/run_*/
experiments/**/version_*/
experiments/**
!experiments/**/
!experiments/**/*.py
!experiments/**/*.sh
!experiments/**/*.md
!experiments/**/*.yaml
!experiments/**/*.yml
!experiments/**/*.toml
!experiments/**/*.ipynb
!experiments/**/*.txt
# Tabular / image outputs (regenerate from scripts; not pushed)
experiments/**/*.csv
experiments/**/*.tsv
# Explicitly block large / generated artifacts even if extension matched elsewhere
experiments/**/*.h5ad
experiments/**/*.h5
experiments/**/*.loom
experiments/**/*.zarr
experiments/**/*.zarr/
experiments/**/*.ckpt
experiments/**/*.pt
experiments/**/*.pth
experiments/**/*.safetensors
experiments/**/*.npz
experiments/**/*.npy
experiments/**/*.pkl
experiments/**/*.pickle
experiments/**/*.hdf5
experiments/**/checkpoints/
experiments/**/wandb/
experiments/**/lightning_logs/
experiments/**/outputs/
experiments/**/plots/
experiments/**/*.png
experiments/**/*.jpg
experiments/**/*.jpeg
experiments/**/*.pdf
experiments/**/*.svg
experiments/**/*.gif
experiments/**/*.mp4
experiments/**/*.zip
experiments/**/*.tar
experiments/**/*.tar.gz
experiments/**/*.tgz
experiments/**/*.parquet
experiments/**/*.feather
experiments/**/*.mtx
experiments/**/*.gz
experiments/**/*.bz2
experiments/**/*.rds

# Re-ignore run artefacts (negated extensions above would otherwise track run/config.yaml)
experiments/**/run_*/
experiments/**/version_*/
experiments/**/CollecTRI/
experiments/**/X_state/
experiments/**/X_state_gene_decoder/
experiments/**/emb_finetune_parse/
experiments/**/h5ad/
experiments/**/figures/
experiments/**/metrics_archive/
experiments/**/logs/

# --- STATE / ML run outputs at repo root (can be huge) ---
lightning_logs/
outputs/
log/
wandb/
wandb_logs/
cell-eval-outdir/
analyse_results/
archive/
tmp/
temp/
notebooks/

# --- Slurm / cluster logs ---
slurm-*.out
slurm-*.err
*.slurm
vci_job_*
hostfile

# --- Apptainer / images ---
*.sif

# --- Accidental home-style dirs in repo root (from jobs using -H $PWD) ---
.cache/
.config/
.local/
.fontconfig/

# --- Misc generated / one-off artifacts at repo root ---
project_gantt_chart*.pdf
project_gantt_chart*.png
cv_pred_*_*.out
cv_pred_*_*.err
